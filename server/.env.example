# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (never commit the real one)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cas_dev?schema=public
# Separate database used ONLY by the automated tests (it is wiped on every run)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cas_test?schema=public

# Public URL of the web app (used for CORS and for links in e-mails)
APP_URL=http://localhost:5173

# ── Sessions / cookies ──────────────────────────────────
SESSION_TTL_HOURS=12
# Set to true behind HTTPS (always true when NODE_ENV=production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 = none)
TRUST_PROXY=0

# ── E-mail (required in production for verification / reset links) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Company Accounting <no-reply@example.com>"

# ── File uploads ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Razorpay (optional). Leave empty to run in transaction-recording mode ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Serve the built client from the API process (single-host deployment) ──
SERVE_CLIENT=false

# ── Optional development sample data (npm run seed:dev). Never used in production ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
