generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubtype {
  CASH
  BANK
  RECEIVABLE
  PAYABLE
  TAX_INPUT
  TAX_OUTPUT
  OPENING_EQUITY
  REVENUE
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PlGroup {
  SALES_REVENUE
  OTHER_OPERATING_INCOME
  DIRECT_COST
  COST_OF_GOODS_SOLD
  EMPLOYEE
  RENT_UTILITIES
  MARKETING
  TRANSPORTATION
  ADMINISTRATIVE
  OTHER_EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
  RECEIPT
  SUPPLIER_PAYMENT
  REFUND
  OPENING_BALANCE
}

enum TransactionStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  PAYMENT_GATEWAY
  CHEQUE
  CREDIT
  OTHER
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED
}

enum RefundStatus {
  NONE
  PARTIAL
  FULL
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum ReconStatus {
  UNRECONCILED
  RECONCILED
}

enum AccountingMethod {
  ACCRUAL
  CASH
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum FlowDirection {
  IN
  OUT
}

// ───────────────────────── Tenancy & identity ─────────────────────────

model Company {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String?
  gstin              String?
  pan                String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String   @default("India")
  postalCode         String?
  website            String?
  baseCurrency       String   @default("INR")
  fyStartMonth       Int      @default(4)
  logoAttachmentId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settings           CompanySettings?
  users              User[]
  accounts           Account[]
  categories         TransactionCategory[]
  transactions       Transaction[]
  journalEntries     JournalEntry[]
  customers          Customer[]
  suppliers          Supplier[]
  invoices           Invoice[]
  payments           Payment[]
  taxRates           TaxRate[]
  attachments        Attachment[]
  auditLogs          AuditLog[]
}

model CompanySettings {
  id                      String           @id @default(cuid())
  companyId               String           @unique
  company                 Company          @relation(fields: [companyId], references: [id])
  accountingMethod        AccountingMethod @default(ACCRUAL)
  expenseApprovalRequired Boolean          @default(false)
  allowSelfApproval       Boolean          @default(false)
  taxEnabled              Boolean          @default(false)
  taxLabel                String           @default("GST")
  invoicePrefix           String           @default("INV-")
  invoiceDueDays          Int              @default(15)
  invoiceNotes            String?
  invoiceTerms            String?
  notifyExpenseApproval   Boolean          @default(true)
  notifyPaymentReceived   Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id               String     @id @default(cuid())
  companyId        String?
  company          Company?   @relation(fields: [companyId], references: [id])
  roleId           String
  role             Role       @relation(fields: [roleId], references: [id])
  fullName         String
  email            String     @unique
  phone            String?
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions           UserSession[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]

  @@index([companyId])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  csrfToken  String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── Ledger ─────────────────────────

model Account {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  code                String
  name                String
  type                AccountType
  subtype             AccountSubtype
  isSystem            Boolean        @default(false)
  isActive            Boolean        @default(true)
  bankName            String?
  bankAccountType     String?
  accountNumberMasked String?
  openingBalance      Decimal        @default(0) @db.Decimal(18, 2)
  openingDate         DateTime?      @db.Date
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  journalLines        JournalEntryLine[]
  accountTransactions AccountTransaction[]
  statementLines      BankStatementLine[]

  @@unique([companyId, code])
  @@index([companyId, subtype])
}

model TransactionCategory {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  type      CategoryType
  plGroup   PlGroup
  isSystem  Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
  journalLines JournalEntryLine[]
  invoiceItems InvoiceItem[]

  @@unique([companyId, type, name])
}

model Transaction {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  number               String
  type                 TransactionType
  status               TransactionStatus @default(POSTED)
  date                 DateTime          @db.Date
  amount               Decimal           @db.Decimal(18, 2)
  taxAmount            Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal           @db.Decimal(18, 2)
  taxRecoverable       Boolean           @default(false)
  currency             String
  categoryId           String?
  category             TransactionCategory? @relation(fields: [categoryId], references: [id])
  paymentMethod        PaymentMethod
  sourceAccountId      String?
  destinationAccountId String?
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id])
  supplierId           String?
  supplier             Supplier?         @relation(fields: [supplierId], references: [id])
  invoiceId            String?
  reference            String?
  description          String?
  reason               String?
  onCredit             Boolean           @default(false)
  amountPaid           Decimal           @default(0) @db.Decimal(18, 2)
  dueDate              DateTime?         @db.Date
  isReversal           Boolean           @default(false)
  reversalOfId         String?           @unique
  reversalOf           Transaction?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy           Transaction?      @relation("Reversal")
  attachmentId         String?
  createdById          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  expense             Expense?
  journalEntries      JournalEntry[]
  accountTransactions AccountTransaction[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, type, status])
  @@index([companyId, categoryId])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
}

model Expense {
  id              String         @id @default(cuid())
  companyId       String
  transactionId   String         @unique
  transaction     Transaction    @relation(fields: [transactionId], references: [id])
  approvalStatus  ApprovalStatus @default(NOT_REQUIRED)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, approvalStatus])
}

model JournalEntry {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  number        String
  date          DateTime     @db.Date
  description   String?
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  isReversal    Boolean      @default(false)
  createdById   String?
  createdAt     DateTime     @default(now())

  lines JournalEntryLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([transactionId])
  @@index([invoiceId])
}

model JournalEntryLine {
  id             String               @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry         @relation(fields: [journalEntryId], references: [id])
  companyId      String
  accountId      String
  account        Account              @relation(fields: [accountId], references: [id])
  debit          Decimal              @default(0) @db.Decimal(18, 2)
  credit         Decimal              @default(0) @db.Decimal(18, 2)
  categoryId     String?
  category       TransactionCategory? @relation(fields: [categoryId], references: [id])
  customerId     String?
  supplierId     String?
  memo           String?

  @@index([journalEntryId])
  @@index([companyId, accountId])
  @@index([companyId, customerId])
  @@index([companyId, supplierId])
}

// Cash / bank book: one row per movement on a cash or bank account.
model AccountTransaction {
  id            String        @id @default(cuid())
  companyId     String
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id])
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  date          DateTime      @db.Date
  direction     FlowDirection
  amount        Decimal       @db.Decimal(18, 2)
  paymentMethod PaymentMethod
  isTransfer    Boolean       @default(false)
  reconciledAt  DateTime?
  reconciledById String?
  createdAt     DateTime      @default(now())

  statementLine BankStatementLine?

  @@index([companyId, accountId, date])
  @@index([transactionId])
}

model BankStatementLine {
  id                   String              @id @default(cuid())
  companyId            String
  accountId            String
  account              Account             @relation(fields: [accountId], references: [id])
  date                 DateTime            @db.Date
  description          String?
  reference            String?
  amount               Decimal             @db.Decimal(18, 2) // signed: + deposit, - withdrawal
  fingerprint          String
  matchedId            String?             @unique
  matched              AccountTransaction? @relation(fields: [matchedId], references: [id])
  importedById         String
  createdAt            DateTime            @default(now())

  @@unique([accountId, fingerprint])
  @@index([companyId, accountId, date])
}

// ───────────────────────── Parties ─────────────────────────

model Customer {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  businessName   String?
  email          String?
  phone          String?
  address        String?
  gstin          String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices     Invoice[]
  transactions Transaction[]
  payments     Payment[]

  @@index([companyId, name])
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  businessName   String?
  email          String?
  phone          String?
  address        String?
  gstin          String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]
  payments     Payment[]

  @@index([companyId, name])
}

// ───────────────────────── Invoicing & payments ─────────────────────────

model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  number        String
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  currency      String
  subtotal      Decimal       @db.Decimal(18, 2)
  discountTotal Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)
  notes         String?
  terms         String?
  cancelReason  String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  allocations    PaymentAllocation[]
  journalEntries JournalEntry[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, issueDate])
}

model InvoiceItem {
  id          String               @id @default(cuid())
  invoiceId   String
  invoice     Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal              @db.Decimal(14, 3)
  unitPrice   Decimal              @db.Decimal(18, 2)
  discount    Decimal              @default(0) @db.Decimal(18, 2)
  taxRate     Decimal              @default(0) @db.Decimal(5, 2)
  categoryId  String
  category    TransactionCategory  @relation(fields: [categoryId], references: [id])
  lineNet     Decimal              @db.Decimal(18, 2)
  lineTax     Decimal              @db.Decimal(18, 2)
  lineTotal   Decimal              @db.Decimal(18, 2)

  @@index([invoiceId])
}

model Payment {
  id               String           @id @default(cuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  number           String
  direction        PaymentDirection
  status           PaymentStatus
  method           PaymentMethod
  gateway          String?
  gatewayPaymentId String?
  gatewayOrderId   String?
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  supplierId       String?
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  billTransactionId String?
  categoryId       String?
  accountId        String
  date             DateTime         @db.Date
  amount           Decimal          @db.Decimal(18, 2)
  fee              Decimal          @default(0) @db.Decimal(18, 2)
  currency         String
  refundedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  refundStatus     RefundStatus     @default(NONE)
  reconStatus      ReconStatus      @default(UNRECONCILED)
  reconciledAt     DateTime?
  transactionId    String?          @unique
  reference        String?
  notes            String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@unique([companyId, gateway, gatewayPaymentId])
  @@index([companyId, status])
  @@index([companyId, date])
  @@index([gatewayOrderId])
}

// Signed allocations: positive when a payment settles a document, negative
// when a refund or reversal releases it. Sum per document = amount paid.
model PaymentAllocation {
  id                String   @id @default(cuid())
  companyId         String
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id])
  transactionId     String
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  billTransactionId String?
  amount            Decimal  @db.Decimal(18, 2)
  date              DateTime @db.Date
  createdAt         DateTime @default(now())

  @@index([companyId, invoiceId])
  @@index([companyId, billTransactionId])
  @@index([paymentId])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  status      String    @default("RECEIVED")
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

// ───────────────────────── Supporting ─────────────────────────

model Attachment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  purpose      String
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  userId     String?
  userName   String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([userId])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  userId         String
  key            String
  method         String
  path           String
  state          String   @default("IN_PROGRESS")
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

model Sequence {
  companyId String
  name      String
  value     Int    @default(0)

  @@id([companyId, name])
}
