{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:all && npm --prefix server run prisma:generate",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "server/{prisma/schema.prisma,node_modules/.prisma/client/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/housekeeping", "schedule": "30 3 * * *" }
  ]
}
